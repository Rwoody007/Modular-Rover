const int stepPin = 8; // Added stepPin definition
const int dirPin = 9;
const int potPin = A0; // Potentiometer input

void setup() {
  pinMode(stepPin, OUTPUT);
  pinMode(dirPin, OUTPUT);
  
  digitalWrite(dirPin, HIGH); // Set constant direction
}

void loop() {
  // 1. Read the potentiometer (0 to 1023)
  int potValue = analogRead(potPin);

  // 2. Map the value to a delay range (in microseconds)
  // 2000 is slow, 500 is fast. Adjust these numbers to suit your motor.
  int customDelay = map(potValue, 0, 1023, 2000, 500);

  // 3. Step the motor
  digitalWrite(stepPin, HIGH);
  delayMicroseconds(customDelay);
  digitalWrite(stepPin, LOW);
  delayMicroseconds(customDelay);
}
