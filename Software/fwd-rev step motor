const int stepPin = 8;
const int dirPin = 9;

void setup() {
  pinMode(stepPin, OUTPUT);
  pinMode(dirPin, OUTPUT);
}

void stepMotor(int steps, int dir) {
  digitalWrite(dirPin, dir);

  for (int i = 0; i < steps; i++) {
    digitalWrite(stepPin, HIGH);
    delayMicroseconds(500);
    digitalWrite(stepPin, LOW);
    delayMicroseconds(500);
  }
}

void loop() {
  // Forward
  stepMotor(2000, HIGH);
  delay(1000);

  // Reverse
  stepMotor(2000, LOW);
  delay(1000);
}
